<div class="tab active {{#if isBoardView}}board-canvas{{/if}}" data-tab="{{activeTab}}">
  
  {{#if isWorkspaces}}
    {{> "modules/ClueBook/templates/partials/tab-workspaces.hbs"}}
  {{/if}}
  {{#if isSettings}}
    {{> "modules/ClueBook/templates/partials/tab-settings.hbs"}}
  {{else}}
  


  {{#if (eq activeTab "search")}}
  <div class="search-container" style="padding: 10px; background: rgba(0,0,0,0.2); border-bottom: 1px solid rgba(255,255,255,0.1);">
    <div style="position: relative;">
      <i class="fas fa-search search-icon"></i>
      <input type="text" id="cluebook-search" class="cluebook-search-input" placeholder="{{localize "CLUEBOOK.Settings.SearchPlaceholder"}}" value="{{searchQuery}}">
      {{#if (or searchQuery searchTags.length)}}
      <i id="cluebook-search-clear" class="fas fa-times-circle" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: rgba(255,255,255,0.6); font-size: 14px; transition: color 0.2s;" title="{{localize 'CLUEBOOK.Settings.ClearSearch'}}"></i>
      {{/if}}
    </div>
    
    {{#if availableSearchTags.length}}
    <div class="cluebook-search-tags" style="margin-top: 10px; display: flex; flex-wrap: wrap; gap: 5px;">
      {{#each availableSearchTags}}
      <span class="cb-tag cb-search-tag {{#if this.isActive}}active{{/if}}" data-tag-id="{{this.id}}" style="cursor: pointer; {{#if this.isActive}}background: {{this.color}}; border-color: #fff; box-shadow: 0 0 5px {{this.color}};{{else}}background: transparent; border-color: {{this.color}}; color: {{this.color}}; opacity: 0.7;{{/if}}" title="{{this.name}}{{#if this.isSecret}} ({{localize 'CLUEBOOK.Entry.SecretTag'}}){{/if}}">
        {{#if this.isSecret}}<i class="fas fa-eye-slash" style="opacity:0.6; font-size:10px;"></i>{{/if}}
        {{this.name}}
      </span>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{#if isBoardView}}
  <button class="board-recenter-btn" title="{{localize "CLUEBOOK.Board.Recenter"}}" data-action="recenterBoard">
    <i class="fas fa-crosshairs"></i>
  </button>
  {{/if}}

  <div class="entries-list">
    {{> "modules/ClueBook/templates/partials/tab-board.hbs"}}

    {{#each entries}}
      {{> "modules/ClueBook/templates/partials/entry-card.hbs"}}
    {{/each}}
  </div>

  {{#unless isWorkspaces}}
  {{#unless isSettings}}
  {{#unless entries.length}}
    {{#if (or (ne activeTab "search") searchQuery)}}
    <div class="cb-empty-state-wrapper" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 5;">
      <div class="cb-empty-state">
        <i class="fas {{#if isBoardView}}fa-project-diagram{{else if (eq activeTab "search")}}fa-search{{else}}fa-sticky-note{{/if}}"></i>
        <p>
          {{#if isBoardView}}
            {{{localize "CLUEBOOK.EmptyState.Board"}}}
          {{else if (eq activeTab "search")}}
            {{{localize "CLUEBOOK.EmptyState.Search"}}}
          {{else}}
            {{{localize "CLUEBOOK.EmptyState.List"}}}
          {{/if}}
        </p>
      </div>
    </div>
    {{/if}}
  {{/unless}}
  {{/unless}}
  {{/unless}}

  {{#unless isReadOnly}}
  {{#if showAddBtn}}
  <div class="add-entry-btn-container">
    <button type="button" data-action="addEntry">
      <i class="fas fa-plus"></i> {{localize "CLUEBOOK.Entry.Add"}}
    </button>
  </div>
  {{/if}}
  {{/unless}}

  {{#if isBoardView}}
  {{#if settings.theme.showHotkeys}}
  <div class="board-hotkeys-hint premium-legend">
    <div class="legend-header">
      <span><i class="fas fa-keyboard"></i> {{localize "CLUEBOOK.Hotkeys.Title"}}</span>
      <i class="fas fa-times close-legend" data-action="hideHotkeys" title="{{localize "CLUEBOOK.Hotkeys.HideHint"}}"></i>
    </div>
    <div class="legend-grid">
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.LeftClickBackground"}}</kbd> {{localize "CLUEBOOK.Hotkeys.Lasso"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.RightClickBackground"}}</kbd> {{localize "CLUEBOOK.Hotkeys.CreateEntry"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.RightClickGroup"}}</kbd> {{localize "CLUEBOOK.Hotkeys.Align"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.ShiftLeftClick"}}</kbd> {{localize "CLUEBOOK.Hotkeys.SelectGrid"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.ControlLeftClick"}}</kbd> {{localize "CLUEBOOK.Hotkeys.CreateLink"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.MouseWheel"}}</kbd> {{localize "CLUEBOOK.Hotkeys.Zoom"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.MouseWheelClick"}}</kbd> {{localize "CLUEBOOK.Hotkeys.Pan"}}</div>
    </div>   
  </div>
  {{/if}}
  {{/if}}
  {{/if}}
</div>
