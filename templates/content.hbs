<div class="tab active {{#if isBoardView}}board-canvas{{/if}}" data-tab="{{activeTab}}">
  
  {{#if isWorkspaces}}
    {{> "modules/ClueBook/templates/partials/tab-workspaces.hbs"}}
  {{/if}}
  {{#if isSettings}}
    {{> "modules/ClueBook/templates/partials/tab-settings.hbs"}}
  {{else}}
  


  {{#if (eq activeTab "search")}}
  <div class="search-container" style="padding: 10px; background: rgba(0,0,0,0.2); border-bottom: 1px solid rgba(255,255,255,0.1);">
    <div style="position: relative;">
      <i class="fas fa-search search-icon"></i>
      <input type="text" id="cluebook-search" class="cluebook-search-input" placeholder="{{localize "CLUEBOOK.Settings.SearchPlaceholder"}}" value="{{searchQuery}}">
      {{#if (or searchQuery searchTags.length)}}
      <i id="cluebook-search-clear" class="fas fa-times-circle" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: rgba(255,255,255,0.6); font-size: 14px; transition: color 0.2s;" title="{{localize 'CLUEBOOK.Settings.ClearSearch'}}"></i>
      {{/if}}
    </div>
    
    {{#if availableSearchTags.length}}
    <div class="cluebook-search-tags" style="margin-top: 10px; display: flex; flex-wrap: wrap; gap: 5px;">
      {{#each availableSearchTags}}
      <span class="cb-tag cb-search-tag {{#if this.isActive}}active{{/if}}" data-tag-id="{{this.id}}" style="cursor: pointer; {{#if this.isActive}}background: {{this.color}}; border-color: #fff; box-shadow: 0 0 5px {{this.color}};{{else}}background: transparent; border-color: {{this.color}}; color: {{this.color}}; opacity: 0.7;{{/if}}" title="{{this.name}}{{#if this.isSecret}} ({{localize 'CLUEBOOK.Entry.SecretTag'}}){{/if}}">
        {{#if this.isSecret}}<i class="fas fa-eye-slash" style="opacity:0.6; font-size:10px;"></i>{{/if}}
        {{this.name}}
      </span>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{#if isBoardView}}
  <button class="board-recenter-btn" title="{{localize "CLUEBOOK.Board.Recenter"}}" data-action="recenterBoard">
    <i class="fas fa-crosshairs"></i>
  </button>
  {{/if}}

  {{#if (eq activeTab "quests")}}
  <div class="cb-status-filter-strip">
    <button type="button" class="cb-filter-pill {{#if (or (eq activeQuestFilter 'all') (not activeQuestFilter))}}active{{/if}}" data-action="filterQuestStatus" data-status="all">
      {{localize "CLUEBOOK.Filter.All"}} <span class="cb-filter-count">{{questCounts.all}}</span>
    </button>
    <button type="button" class="cb-filter-pill {{#if (eq activeQuestFilter 'active')}}active{{/if}}" data-action="filterQuestStatus" data-status="active">
      ⏳ {{localize "CLUEBOOK.Filter.Active"}} <span class="cb-filter-count">{{questCounts.active}}</span>
    </button>
    <button type="button" class="cb-filter-pill {{#if (eq activeQuestFilter 'completed')}}active{{/if}}" data-action="filterQuestStatus" data-status="completed">
      ✅ {{localize "CLUEBOOK.Filter.Completed"}} <span class="cb-filter-count">{{questCounts.completed}}</span>
    </button>
    <button type="button" class="cb-filter-pill {{#if (eq activeQuestFilter 'failed')}}active{{/if}}" data-action="filterQuestStatus" data-status="failed">
      ❌ {{localize "CLUEBOOK.Filter.Failed"}} <span class="cb-filter-count">{{questCounts.failed}}</span>
    </button>
  </div>
  {{/if}}

  {{#if (eq activeTab "npc")}}
  <div class="cb-status-filter-strip">
    <button type="button" class="cb-filter-pill {{#if (or (eq activeNpcFilter 'all') (not activeNpcFilter))}}active{{/if}}" data-action="filterNpcStatus" data-status="all">
      {{localize "CLUEBOOK.Filter.All"}} <span class="cb-filter-count">{{npcCounts.all}}</span>
    </button>
    <button type="button" class="cb-filter-pill {{#if (eq activeNpcFilter 'alive')}}active{{/if}}" data-action="filterNpcStatus" data-status="alive">
      💚 {{localize "CLUEBOOK.Filter.Alive"}} <span class="cb-filter-count">{{npcCounts.alive}}</span>
    </button>
    <button type="button" class="cb-filter-pill {{#if (eq activeNpcFilter 'dead')}}active{{/if}}" data-action="filterNpcStatus" data-status="dead">
      💀 {{localize "CLUEBOOK.Filter.Dead"}} <span class="cb-filter-count">{{npcCounts.dead}}</span>
    </button>
    <button type="button" class="cb-filter-pill {{#if (eq activeNpcFilter 'unknown')}}active{{/if}}" data-action="filterNpcStatus" data-status="unknown">
      ❓ {{localize "CLUEBOOK.Filter.Unknown"}} <span class="cb-filter-count">{{npcCounts.unknown}}</span>
    </button>
  </div>
  {{/if}}

  <div class="entries-list">
    {{> "modules/ClueBook/templates/partials/tab-board.hbs"}}

    {{#each entries}}
      {{> "modules/ClueBook/templates/partials/entry-card.hbs"}}
    {{/each}}

    {{#if archivedQuestEntries.length}}
    <div class="cb-archive-section {{#if isQuestArchiveOpen}}is-open{{/if}}">
      <div class="cb-archive-header" data-action="toggleQuestArchive">
        <div class="cb-archive-title">
          <i class="fas fa-box-archive"></i>
          <span>{{localize "CLUEBOOK.Archive.CompletedQuests"}}</span>
          <span class="cb-archive-badge">{{archivedQuestEntries.length}}</span>
        </div>
        <i class="fas fa-chevron-down cb-archive-chevron"></i>
      </div>
      <div class="cb-archive-content">
        {{#each archivedQuestEntries}}
          {{> "modules/ClueBook/templates/partials/entry-card.hbs"}}
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if archivedNpcEntries.length}}
    <div class="cb-archive-section {{#if isNpcArchiveOpen}}is-open{{/if}}">
      <div class="cb-archive-header" data-action="toggleNpcArchive">
        <div class="cb-archive-title">
          <i class="fas fa-skull"></i>
          <span>{{localize "CLUEBOOK.Archive.DeadNPC"}}</span>
          <span class="cb-archive-badge">{{archivedNpcEntries.length}}</span>
        </div>
        <i class="fas fa-chevron-down cb-archive-chevron"></i>
      </div>
      <div class="cb-archive-content">
        {{#each archivedNpcEntries}}
          {{> "modules/ClueBook/templates/partials/entry-card.hbs"}}
        {{/each}}
      </div>
    </div>
    {{/if}}
  </div>

  {{#unless isWorkspaces}}
  {{#unless isSettings}}
  {{#unless (or entries.length archivedQuestEntries.length archivedNpcEntries.length)}}
    {{#if (or (ne activeTab "search") searchQuery)}}
    <div class="cb-empty-state-wrapper" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 5;">
      <div class="cb-empty-state">
        <i class="fas {{#if isBoardView}}fa-project-diagram{{else if (eq activeTab "search")}}fa-search{{else}}fa-sticky-note{{/if}}"></i>
        <p>
          {{#if isBoardView}}
            {{{localize "CLUEBOOK.EmptyState.Board"}}}
          {{else if (eq activeTab "search")}}
            {{{localize "CLUEBOOK.EmptyState.Search"}}}
          {{else}}
            {{{localize "CLUEBOOK.EmptyState.List"}}}
          {{/if}}
        </p>
      </div>
    </div>
    {{/if}}
  {{/unless}}
  {{/unless}}
  {{/unless}}

  {{#unless isReadOnly}}
  {{#if showAddBtn}}
  <div class="add-entry-btn-container">
    <button type="button" data-action="addEntry">
      <i class="fas fa-plus"></i> {{localize "CLUEBOOK.Entry.Add"}}
    </button>
    {{#if (eq activeTab "gallery")}}
    <button type="button" data-action="uploadBatchGallery" class="cb-btn-batch-upload" style="background: linear-gradient(135deg, #00acc1 0%, #00838f 100%);" title="{{localize "CLUEBOOK.Gallery.BatchUploadHint"}}">
      <i class="fas fa-images"></i> {{localize "CLUEBOOK.Gallery.BatchUpload"}}
    </button>
    <input type="file" class="cb-batch-file-input" multiple accept="image/*" style="display: none;">
    {{/if}}
  </div>
  {{/if}}
  {{/unless}}

  {{#if isBoardView}}
  {{#if settings.theme.showHotkeys}}
  <div class="board-hotkeys-hint premium-legend">
    <div class="legend-header">
      <span><i class="fas fa-keyboard"></i> {{localize "CLUEBOOK.Hotkeys.Title"}}</span>
      <i class="fas fa-times close-legend" data-action="hideHotkeys" title="{{localize "CLUEBOOK.Hotkeys.HideHint"}}"></i>
    </div>
    <div class="legend-grid">
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.LeftClickBackground"}}</kbd> {{localize "CLUEBOOK.Hotkeys.Lasso"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.RightClickBackground"}}</kbd> {{localize "CLUEBOOK.Hotkeys.CreateEntry"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.RightClickGroup"}}</kbd> {{localize "CLUEBOOK.Hotkeys.Align"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.ShiftLeftClick"}}</kbd> {{localize "CLUEBOOK.Hotkeys.SelectGrid"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.AltLeftClick"}}</kbd> {{localize "CLUEBOOK.Hotkeys.PlacePin"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.CtrlV"}}</kbd> {{localize "CLUEBOOK.Hotkeys.PasteImage"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.ControlLeftClick"}}</kbd> {{localize "CLUEBOOK.Hotkeys.CreateLink"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.MouseWheel"}}</kbd> {{localize "CLUEBOOK.Hotkeys.Zoom"}}</div>
      <div class="legend-item"><kbd>{{localize "CLUEBOOK.Hotkeys.MouseWheelClick"}}</kbd> {{localize "CLUEBOOK.Hotkeys.Pan"}}</div>
    </div>   
  </div>
  {{/if}}
  {{/if}}
  {{/if}}
</div>
