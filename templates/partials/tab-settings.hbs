  <div class="settings-container">
    <h2><i class="fas fa-cog"></i> {{localize "CLUEBOOK.Settings.Title"}} {{#if isShared}}{{localize "CLUEBOOK.Settings.Shared"}}{{else}}{{localize "CLUEBOOK.Settings.Personal"}}{{/if}}</h2>
    <p class="settings-hint">
      {{#if isShared}}{{localize "CLUEBOOK.Settings.SharedHint"}}{{else}}{{localize "CLUEBOOK.Settings.PersonalHint"}}{{/if}}
    </p>

    <div class="settings-grid">
      <div class="settings-card">
        <h3><i class="fas fa-paint-brush"></i> {{localize "CLUEBOOK.Settings.CategoryWindow"}}</h3>
        <div class="setting-row">
          <label>{{localize "CLUEBOOK.Settings.AccentColor"}}</label>
          <input type="color" class="setting-input" data-key="theme.accent" value="{{settings.theme.accent}}">
        </div>
        <div class="setting-row">
          <label>{{localize "CLUEBOOK.Settings.Opacity"}}</label>
          <input type="range" class="setting-input" data-key="theme.opacity" min="40" max="100" value="{{settings.theme.opacity}}">
        </div>
      </div>

      <div class="settings-card">
        <h3><i class="fas fa-magic"></i> {{localize "CLUEBOOK.Settings.CategoryFAB"}}</h3>

        <div class="setting-row">
          <label>{{localize "CLUEBOOK.Settings.UIMode"}}</label>
          <select class="setting-input cluebook-input" data-key="theme.uiMode">
            <option value="widget" {{#if (ne settings.theme.uiMode "controls")}}selected{{/if}}>{{localize "CLUEBOOK.Settings.UIModeWidget"}}</option>
            <option value="controls" {{#if (eq settings.theme.uiMode "controls")}}selected{{/if}}>{{localize "CLUEBOOK.Settings.UIModeControls"}}</option>
          </select>
        </div>
        <div class="setting-row">
          <label>{{localize "CLUEBOOK.Settings.Direction"}}</label>
          <select class="setting-input cluebook-input" data-key="widget.direction">
            <option value="up-right" {{#if (eq settings.widget.direction "up-right")}}selected{{/if}}>{{localize "CLUEBOOK.Settings.UpRight"}}</option>
            <option value="up-left" {{#if (eq settings.widget.direction "up-left")}}selected{{/if}}>{{localize "CLUEBOOK.Settings.UpLeft"}}</option>
            <option value="down-right" {{#if (eq settings.widget.direction "down-right")}}selected{{/if}}>{{localize "CLUEBOOK.Settings.DownRight"}}</option>
            <option value="down-left" {{#if (eq settings.widget.direction "down-left")}}selected{{/if}}>{{localize "CLUEBOOK.Settings.DownLeft"}}</option>
          </select>
        </div>
        <div class="setting-row">
          <label>{{localize "CLUEBOOK.Settings.WidgetColor"}}</label>
          <input type="color" class="setting-input" data-key="theme.widgetColor" value="{{settings.theme.widgetColor}}">
        </div>
        <div class="setting-row">
          <label>{{localize "CLUEBOOK.Settings.WidgetColor2"}}</label>
          <input type="color" class="setting-input" data-key="theme.widgetColor2" value="{{settings.theme.widgetColor2}}">
        </div>
        <div class="setting-row" style="flex-direction: column; align-items: flex-start; gap: 8px;">
          <label style="margin-bottom: 5px;"><strong>{{localize "CLUEBOOK.Settings.MenuButtonsLabel"}}</strong></label>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%;">
            <div class="setting-row flex-checkbox" style="padding: 0;">
              <label style="font-size: 11px;"><i class="fas fa-sticky-note"></i> {{localize "CLUEBOOK.Settings.ShowBtnNotes"}}</label>
              <div class="cb-toggle cb-toggle-small">
                <input type="checkbox" class="setting-input" id="cb-sw-btn-notes" data-key="widget.buttons.notes" {{#if (ne settings.widget.buttons.notes false)}}checked{{/if}}>
                <label for="cb-sw-btn-notes"></label>
              </div>
            </div>
            <div class="setting-row flex-checkbox" style="padding: 0;">
              <label style="font-size: 11px;"><i class="fas fa-user"></i> {{localize "CLUEBOOK.Settings.ShowBtnNPC"}}</label>
              <div class="cb-toggle cb-toggle-small">
                <input type="checkbox" class="setting-input" id="cb-sw-btn-npc" data-key="widget.buttons.npc" {{#if (ne settings.widget.buttons.npc false)}}checked{{/if}}>
                <label for="cb-sw-btn-npc"></label>
              </div>
            </div>
            <div class="setting-row flex-checkbox" style="padding: 0;">
              <label style="font-size: 11px;"><i class="fas fa-map-marked-alt"></i> {{localize "CLUEBOOK.Settings.ShowBtnLocations"}}</label>
              <div class="cb-toggle cb-toggle-small">
                <input type="checkbox" class="setting-input" id="cb-sw-btn-loc" data-key="widget.buttons.locations" {{#if (ne settings.widget.buttons.locations false)}}checked{{/if}}>
                <label for="cb-sw-btn-loc"></label>
              </div>
            </div>
            <div class="setting-row flex-checkbox" style="padding: 0;">
              <label style="font-size: 11px;"><i class="fas fa-scroll"></i> {{localize "CLUEBOOK.Settings.ShowBtnQuests"}}</label>
              <div class="cb-toggle cb-toggle-small">
                <input type="checkbox" class="setting-input" id="cb-sw-btn-quests" data-key="widget.buttons.quests" {{#if (ne settings.widget.buttons.quests false)}}checked{{/if}}>
                <label for="cb-sw-btn-quests"></label>
              </div>
            </div>
            <div class="setting-row flex-checkbox" style="padding: 0;">
              <label style="font-size: 11px;"><i class="fas fa-clock"></i> {{localize "CLUEBOOK.Settings.ShowBtnTimeline"}}</label>
              <div class="cb-toggle cb-toggle-small">
                <input type="checkbox" class="setting-input" id="cb-sw-btn-time" data-key="widget.buttons.timeline" {{#if (ne settings.widget.buttons.timeline false)}}checked{{/if}}>
                <label for="cb-sw-btn-time"></label>
              </div>
            </div>
            <div class="setting-row flex-checkbox" style="padding: 0;">
              <label style="font-size: 11px;"><i class="fas fa-tasks"></i> {{localize "CLUEBOOK.Settings.ShowBtnTracker"}}</label>
              <div class="cb-toggle cb-toggle-small">
                <input type="checkbox" class="setting-input" id="cb-sw-btn-tracker" data-key="widget.buttons.tracker" {{#if (ne settings.widget.buttons.tracker false)}}checked{{/if}}>
                <label for="cb-sw-btn-tracker"></label>
              </div>
            </div>
          </div>
        </div>
      </div>


      <div class="settings-card">
        <h3><i class="fas fa-tasks"></i> {{localize "CLUEBOOK.Settings.CategoryTrackerWidget"}}</h3>
        <div class="setting-row flex-checkbox">
          <label>{{localize "CLUEBOOK.Settings.EnableTracker"}}</label>
          <div class="cb-toggle">
            <input type="checkbox" class="setting-input" id="cb-sw-enable-tracker" data-key="features.enableTracker" {{#if (ne settings.features.enableTracker false)}}checked{{/if}}>
            <label for="cb-sw-enable-tracker"></label>
          </div>
        </div>
        <div class="setting-row flex-checkbox">
          <label>{{localize "CLUEBOOK.Tracker.ShowOverdue"}}</label>
          <div class="cb-toggle">
            <input type="checkbox" class="setting-input" id="cb-sw-overdue" data-key="features.showOverdueInTracker" {{#if (ne settings.features.showOverdueInTracker false)}}checked{{/if}}>
            <label for="cb-sw-overdue"></label>
          </div>
        </div>
      </div>

      <div class="settings-card">
        <h3><i class="fas fa-plug"></i> {{localize "CLUEBOOK.Settings.CategoryIntegrations"}}</h3>
        <div class="setting-row flex-checkbox">
          <label>{{localize "CLUEBOOK.Settings.CardsExplicitLinks"}}</label>
          <div class="cb-toggle">
            <input type="checkbox" class="setting-input" id="cb-sw-cards-links" data-key="features.cardsShowExplicitLinks" {{#if (ne settings.features.cardsShowExplicitLinks false)}}checked{{/if}}>
            <label for="cb-sw-cards-links"></label>
          </div>
        </div>
        <div class="setting-row flex-checkbox">
          <label>{{localize "CLUEBOOK.Settings.HideTagsSys"}}</label>
          <div class="cb-toggle">
            <input type="checkbox" class="setting-input" id="cb-sw-hide-tags" data-key="features.hideTags" {{#if settings.features.hideTags}}checked{{/if}}>
            <label for="cb-sw-hide-tags"></label>
          </div>
        </div>
        <div class="setting-row flex-checkbox">
          <label>{{localize "CLUEBOOK.Settings.HideTagsOnCards"}}</label>
          <div class="cb-toggle">
            <input type="checkbox" class="setting-input" id="cb-sw-hide-tags-cards" data-key="features.hideTagsOnCards" {{#if settings.features.hideTagsOnCards}}checked{{/if}}>
            <label for="cb-sw-hide-tags-cards"></label>
          </div>
        </div>
        <div class="setting-row flex-checkbox">
          <label>{{localize "CLUEBOOK.Settings.HideEditBtn"}}</label>
          <div class="cb-toggle">
            <input type="checkbox" class="setting-input" id="cb-sw-hide-edit" data-key="features.hideEditBtn" {{#if settings.features.hideEditBtn}}checked{{/if}}>
            <label for="cb-sw-hide-edit"></label>
          </div>
        </div>
        <div class="setting-row flex-checkbox">
          <label>{{localize "CLUEBOOK.Settings.BoardExplicitLinks"}}</label>
          <div class="cb-toggle">
            <input type="checkbox" class="setting-input" id="cb-sw-board-links" data-key="features.boardShowExplicitLinks" {{#if (ne settings.features.boardShowExplicitLinks false)}}checked{{/if}}>
            <label for="cb-sw-board-links"></label>
          </div>
        </div>
        <div class="setting-row flex-checkbox">
          <label>{{localize "CLUEBOOK.Settings.GalleryAlwaysBelow"}}</label>
          <div class="cb-toggle">
            <input type="checkbox" class="setting-input" id="cb-sw-gallery-below" data-key="features.galleryAlwaysBelow" {{#if settings.features.galleryAlwaysBelow}}checked{{/if}}>
            <label for="cb-sw-gallery-below"></label>
          </div>
        </div>
      </div>
      

    </div>

    <!-- About / Support Footer -->
    <div class="cb-about-footer" style="margin-top: 25px; background: rgba(0, 0, 0, 0.2); border: 1px solid rgba(123, 97, 255, 0.3); border-radius: 8px; padding: 15px; display: flex; align-items: center; justify-content: space-between; gap: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
      
      <div style="display: flex; align-items: center; gap: 15px;">
        <i class="fas fa-user-astronaut" style="font-size: 32px; color: var(--cb-accent); drop-shadow: 0 0 10px rgba(123,97,255,0.5);"></i>
        <div style="display: flex; flex-direction: column;">
          <span style="color: #fff; font-weight: bold; font-size: 16px;">ClueBook <span style="color: var(--cb-accent);">by MigaSu</span></span>
          <span style="color: rgba(255,255,255,0.5); font-size: 12px; margin-top: 2px;">{{localize "CLUEBOOK.Settings.AboutSubtitle"}}</span>
        </div>
      </div>
      
      <div style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end;">
        <a href="https://github.com/MigaSu/ClueBook" target="_blank" class="cluebook-btn" title="GitHub Repository" style="text-decoration: none; padding: 6px 12px; font-size: 13px; font-weight: bold; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 4px; transition: all 0.2s; display: flex; align-items: center; gap: 6px;">
          <i class="fab fa-github"></i> GitHub
        </a>
        <a href="https://github.com/MigaSu/ClueBook/discussions" target="_blank" class="cluebook-btn" title="{{localize "CLUEBOOK.Settings.AboutDiscussionsTitle"}}" style="text-decoration: none; padding: 6px 12px; font-size: 13px; font-weight: bold; background: rgba(123, 97, 255, 0.15); border: 1px solid rgba(123, 97, 255, 0.4); color: #fff; border-radius: 4px; transition: all 0.2s; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(123, 97, 255, 0.2);">
          <i class="fas fa-comments"></i> {{localize "CLUEBOOK.Settings.AboutDiscussionsText"}}
        </a>
        <a href="https://boosty.to/migasu" target="_blank" class="cluebook-btn" title="{{localize "CLUEBOOK.Settings.AboutBoostyTitle"}}" style="text-decoration: none; padding: 6px 12px; font-size: 13px; font-weight: bold; background: linear-gradient(135deg, #f15f2c, #ff3366); border: none; color: #fff; border-radius: 4px; transition: all 0.2s; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(241, 95, 44, 0.4);">
          <i class="fas fa-heart"></i> {{localize "CLUEBOOK.Settings.AboutBoostyText"}}
        </a>
      </div>
      
    </div>

  </div>
