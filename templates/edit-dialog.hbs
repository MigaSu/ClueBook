<div class="cb-edit-dialog-form" style="padding: 10px; display: flex; flex-direction: column; gap: 10px; height: 100%; box-sizing: border-box;">
  
  {{#if isGM}}
    <input type="hidden" name="sceneUuid" value="{{entry.sceneUuid}}">
    <input type="hidden" name="actorUuid" value="{{entry.actorUuid}}">
  {{/if}}

  {{#if isMassEdit}}
  <p class="notes" style="margin-bottom: 5px; font-weight: bold; color: var(--color-text-highlight);">
    {{localize "CLUEBOOK.MassEdit.SelectedCount" count=entriesCount}}
  </p>
  {{/if}}

  <!-- Color Row (for standard cards) -->
  {{#unless (or (eq sourceTab "labels") (eq sourceTab "pins"))}}
  <div class="form-group" style="display: flex; gap: 10px; align-items: center; background: rgba(0,0,0,0.2); padding: 5px 10px; border-radius: 6px;">
    <!-- Color Swatches -->
    <div class="color-palette" style="display: flex; gap: 4px; flex-wrap: nowrap; overflow-x: auto; flex: 1; padding-bottom: 6px;">
      <label class="color-swatch color-yellow" title="{{localize 'CLUEBOOK.Colors.Yellow'}}" style="cursor: pointer;"><input type="radio" name="color" value="yellow" style="display:none;" {{#if (eq entry.color "yellow")}}checked{{/if}}></label>
      <label class="color-swatch color-red" title="{{localize 'CLUEBOOK.Colors.Red'}}" style="cursor: pointer;"><input type="radio" name="color" value="red" style="display:none;" {{#if (eq entry.color "red")}}checked{{/if}}></label>
      <label class="color-swatch color-green" title="{{localize 'CLUEBOOK.Colors.Green'}}" style="cursor: pointer;"><input type="radio" name="color" value="green" style="display:none;" {{#if (eq entry.color "green")}}checked{{/if}}></label>
      <label class="color-swatch color-blue" title="{{localize 'CLUEBOOK.Colors.Blue'}}" style="cursor: pointer;"><input type="radio" name="color" value="blue" style="display:none;" {{#if (eq entry.color "blue")}}checked{{/if}}></label>
      <label class="color-swatch color-purple" title="{{localize 'CLUEBOOK.Colors.Purple'}}" style="cursor: pointer;"><input type="radio" name="color" value="purple" style="display:none;" {{#if (eq entry.color "purple")}}checked{{/if}}></label>
      <label class="color-swatch color-orange" title="{{localize 'CLUEBOOK.Colors.Orange'}}" style="cursor: pointer;"><input type="radio" name="color" value="orange" style="display:none;" {{#if (eq entry.color "orange")}}checked{{/if}}></label>
      <label class="color-swatch color-teal" title="{{localize 'CLUEBOOK.Colors.Teal'}}" style="cursor: pointer;"><input type="radio" name="color" value="teal" style="display:none;" {{#if (eq entry.color "teal")}}checked{{/if}}></label>
      <label class="color-swatch color-pink" title="{{localize 'CLUEBOOK.Colors.Pink'}}" style="cursor: pointer;"><input type="radio" name="color" value="pink" style="display:none;" {{#if (eq entry.color "pink")}}checked{{/if}}></label>
      <label class="color-swatch color-brown" title="{{localize 'CLUEBOOK.Colors.Brown'}}" style="cursor: pointer;"><input type="radio" name="color" value="brown" style="display:none;" {{#if (eq entry.color "brown")}}checked{{/if}}></label>
      <label class="color-swatch color-custom" title="{{localize 'CLUEBOOK.Color.Custom'}}" style="cursor: pointer; position: relative; overflow: hidden;">
        <input type="color" name="customColorHex" value="{{#if isCustomColor}}{{entry.color}}{{else}}#7b61ff{{/if}}" style="position: absolute; opacity: 0; width: 200%; height: 200%; left: -50%; top: -50%; cursor: pointer;">
        <input type="radio" name="color" value="custom" style="display:none;" {{#if isCustomColor}}checked{{/if}}>
        <div class="custom-color-bg" style="width: 100%; height: 100%; background: {{#if isCustomColor}}{{entry.color}}{{else}}conic-gradient(red, yellow, lime, aqua, blue, magenta, red){{/if}}; border-radius: 50%;"></div>
      </label>
    </div>
    
    <div style="width: 1px; height: 20px; background: rgba(255,255,255,0.1); margin: 0 5px;"></div>
    
    <!-- Text Color -->
    <div class="color-palette text-color-palette" style="display: flex; gap: 4px;">
      <label class="color-swatch text-color-dark" title="{{localize 'CLUEBOOK.Color.Dark'}}" style="cursor: pointer; width: 24px; height: 24px; border-radius: 4px; background: #e2e8f0; border: 1px solid rgba(0,0,0,0.2); display: flex; align-items: center; justify-content: center;">
        <input type="radio" name="textColor" value="dark" style="display:none;" {{#unless isMassEdit}}{{#if (or (not entry.textColor) (eq entry.textColor "dark"))}}checked{{/if}}{{/unless}}>
        <span style="color: #2d3748; font-weight: bold; font-size: 14px; margin: 0; padding: 0; line-height: 1;">A</span>
      </label>
      <label class="color-swatch text-color-light" title="{{localize 'CLUEBOOK.Color.Light'}}" style="cursor: pointer; width: 24px; height: 24px; border-radius: 4px; background: #2d3748; border: 1px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
        <input type="radio" name="textColor" value="light" style="display:none;" {{#if (eq entry.textColor "light")}}checked{{/if}}>
        <span style="color: #fff; font-weight: bold; font-size: 14px; margin: 0; padding: 0; line-height: 1;">A</span>
      </label>
    </div>
  </div>
  {{/unless}}

  {{#if availableFolders.length}}
  <div class="form-group" style="display: flex; gap: 8px; align-items: center; background: rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 6px 10px;">
    <i class="fas fa-folder" style="color: var(--cb-accent); font-size: 14px;"></i>
    <label style="font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.85); margin: 0; min-width: 50px;">{{localize 'CLUEBOOK.Folder.NameLabel'}}:</label>
    <select name="folderId" class="cluebook-input" style="flex: 1; padding: 4px 8px; height: auto; border-radius: 4px; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.15); color: #fff;">
      <option value="" {{#unless entry.folderId}}selected{{/unless}}>{{localize 'CLUEBOOK.Folder.NoFolder'}}</option>
      {{#each availableFolders}}
        <option value="{{this.id}}" {{#if this.isSelected}}selected{{/if}}>📁 {{this.name}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

  {{#unless isMassEdit}}

  {{#if (eq sourceTab "notes")}}
    <div class="form-group">
      <input type="text" name="name" value="{{entry.name}}" class="cluebook-input cb-input-lg" placeholder="📝 {{localize 'CLUEBOOK.Entry.Title'}}">
    </div>
  {{/if}}

  {{#if (eq sourceTab "npc")}}
    <div class="form-group" style="display: flex; gap: 8px;">
      <input type="text" name="name" value="{{entry.name}}" class="cluebook-input cb-input-lg" placeholder="🎭 {{localize 'CLUEBOOK.Entry.NPCName'}}" style="flex: 1;">
      <select name="lifeStatus" class="cluebook-input cb-input-lg" style="width: 140px; flex: 0 0 auto;">
        <option value="alive" {{#if (or (eq entry.lifeStatus "alive") (and (not entry.lifeStatus) (not entry.isDead)))}}selected{{/if}}>💚 {{localize 'CLUEBOOK.Entry.Alive'}}</option>
        <option value="unknown" {{#if (eq entry.lifeStatus "unknown")}}selected{{/if}}>❓ {{localize 'CLUEBOOK.Entry.Unknown'}}</option>
        <option value="dead" {{#if (or (eq entry.lifeStatus "dead") (and (not entry.lifeStatus) entry.isDead))}}selected{{/if}}>💀 {{localize 'CLUEBOOK.Entry.Dead'}}</option>
      </select>
    </div>
    <div style="display: flex; gap: 8px;">
      <div class="form-group" style="flex: 1;">
        <input type="text" name="location" value="{{entry.location}}" class="cluebook-input" placeholder="📍 {{localize 'CLUEBOOK.Entry.Location'}}" maxlength="150">
      </div>
      <div class="form-group" style="flex: 1;">
        <input type="text" name="attitude" value="{{entry.attitude}}" class="cluebook-input" placeholder="🤝 {{localize 'CLUEBOOK.Entry.Attitude'}}" maxlength="150">
      </div>
    </div>
  {{/if}}

  {{#if (eq sourceTab "locations")}}
    <div class="form-group">
      <input type="text" name="name" value="{{entry.name}}" class="cluebook-input cb-input-lg" placeholder="🗺️ {{localize 'CLUEBOOK.Entry.LocationName'}}">
    </div>
    <div style="display: flex; gap: 8px;">
      <div class="form-group" style="flex: 1;">
        <input type="text" name="subtitle" value="{{entry.subtitle}}" class="cluebook-input" placeholder="📍 {{localize 'CLUEBOOK.Location.Subtitle'}}" maxlength="150">
      </div>
      <div class="form-group" style="flex: 1;">
        <input type="text" name="owner" value="{{entry.owner}}" class="cluebook-input" placeholder="👤 {{localize 'CLUEBOOK.Location.Owner'}}" maxlength="150">
      </div>
    </div>
  {{/if}}

  {{#if (eq sourceTab "quests")}}
    <div class="form-group" style="display: flex; gap: 8px;">
      <select name="status" class="cluebook-input cb-input-lg" style="flex: 1;">
        <option value="active" {{#if (eq entry.status "active")}}selected{{/if}}>▶️ {{localize 'CLUEBOOK.Quest.Active'}}</option>
        <option value="completed" {{#if (eq entry.status "completed")}}selected{{/if}}>✅ {{localize 'CLUEBOOK.Quest.Completed'}}</option>
        <option value="failed" {{#if (eq entry.status "failed")}}selected{{/if}}>❌ {{localize 'CLUEBOOK.Quest.Failed'}}</option>
      </select>
    </div>

    {{#if isSimpleCalendarActive}}
      <fieldset style="border: 1px solid rgba(255,255,255,0.1); padding: 10px; border-radius: 4px; margin: 0;">
        <legend style="padding: 0 5px; font-size: 13px; font-weight: bold;">
          <label style="cursor: pointer; display: flex; align-items: center; gap: 5px;">
            <input type="checkbox" name="hasDeadline" {{#if entry.deadlineTimestamp}}checked{{/if}}>
            {{localize 'CLUEBOOK.Time.BindToTime'}}
          </label>
        </legend>
        <div class="deadline-fields" {{#unless entry.deadlineTimestamp}}style="display:none;"{{/unless}}>
          <div class="cb-segmented-control">
            <label>
              <input type="radio" name="timeMode" value="by" {{#if (or (eq entry.timeMode "by") (not entry.timeMode))}}checked{{/if}}>
              <span><i class="fas fa-hourglass-end"></i> {{localize 'CLUEBOOK.Time.By'}}</span>
            </label>
            <label>
              <input type="radio" name="timeMode" value="at" {{#if (eq entry.timeMode "at")}}checked{{/if}}>
              <span><i class="fas fa-clock"></i> {{localize 'CLUEBOOK.Time.At'}}</span>
            </label>
          </div>
          {{{deadlineDateHTML}}}
        </div>
      </fieldset>
    {{else}}
      <fieldset style="border: 1px solid rgba(255,255,255,0.1); padding: 10px; border-radius: 4px; margin: 0;">
        <legend style="padding: 0 5px; font-size: 13px; font-weight: bold;">{{localize 'CLUEBOOK.Time.TimeDeadline'}}</legend>
        <div class="cb-segmented-control">
          <label>
            <input type="radio" name="timeMode" value="by" {{#if (or (eq entry.timeMode "by") (not entry.timeMode))}}checked{{/if}}>
            <span><i class="fas fa-hourglass-end"></i> {{localize 'CLUEBOOK.Time.By'}}</span>
          </label>
          <label>
            <input type="radio" name="timeMode" value="at" {{#if (eq entry.timeMode "at")}}checked{{/if}}>
            <span><i class="fas fa-clock"></i> {{localize 'CLUEBOOK.Time.At'}}</span>
          </label>
        </div>
        <input type="text" name="deadline" value="{{entry.deadline}}" class="cluebook-input" placeholder="{{localize 'CLUEBOOK.Time.InputPlaceholder'}}">
      </fieldset>
    {{/if}}

    <fieldset class="cb-completed-time-fieldset" style="border: 1px solid rgba(76, 175, 80, 0.3); padding: 10px; border-radius: 4px; margin-top: 8px; {{#unless (eq entry.status 'completed')}}display: none;{{/unless}}">
      <legend style="padding: 0 5px; font-size: 13px; font-weight: bold; color: #81c784;">
        <label style="cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <input type="checkbox" name="hasCompletedTime" {{#if entry.completedTime}}checked{{/if}}>
          ✅ {{localize 'CLUEBOOK.Quest.SpecifyCompletionTime'}}
        </label>
      </legend>
      <div class="cb-completed-time-input" {{#unless entry.completedTime}}style="display:none;"{{/unless}}>
        <input type="text" name="completedTime" value="{{entry.completedTime}}" class="cluebook-input" placeholder="{{localize 'CLUEBOOK.Quest.CompletionTimePlaceholder'}}">
      </div>
    </fieldset>
  {{/if}}

  {{#if (eq sourceTab "timeline")}}
    {{#if isSimpleCalendarActive}}
      <fieldset style="border: 1px solid rgba(255,255,255,0.1); padding: 10px; border-radius: 4px; margin: 0;">
        <legend style="padding: 0 5px; font-size: 13px; font-weight: bold; color: #4caf50;">
          <i class="fas fa-play"></i> {{localize 'CLUEBOOK.Time.StartTime'}}
        </legend>
        {{{startDateHTML}}}
      </fieldset>
      
      <fieldset style="border: 1px solid rgba(255,255,255,0.1); padding: 10px; border-radius: 4px; margin: 0;">
        <legend style="padding: 0 5px; font-size: 13px; font-weight: bold; color: #ff5252;">
          <i class="fas fa-stop"></i> {{localize 'CLUEBOOK.Time.EndTime'}}
        </legend>
        <div style="display: flex; gap: 10px; margin-bottom: 8px; font-size: 13px;">
          <label style="cursor: pointer;"><input type="radio" name="endMode" value="none" {{#if (eq endMode "none")}}checked{{/if}}> {{localize 'CLUEBOOK.Time.EndModeNone'}}</label>
          <label style="cursor: pointer;"><input type="radio" name="endMode" value="time" {{#if (eq endMode "time")}}checked{{/if}}> {{localize 'CLUEBOOK.Time.EndModeTime'}}</label>
          <label style="cursor: pointer;"><input type="radio" name="endMode" value="duration" {{#if (eq endMode "duration")}}checked{{/if}}> {{localize 'CLUEBOOK.Time.EndModeDuration'}}</label>
        </div>
        
        <div class="end-time-fields" {{#unless (eq endMode "time")}}style="display:none;"{{/unless}}>
          {{{endDateHTML}}}
        </div>
        
        <div class="end-duration-fields" {{#unless (eq endMode "duration")}}style="display:none;"{{/unless}}>
          <div style="display: flex; gap: 10px; align-items: center;">
            <div style="flex: 1;">
              <label style="font-size: 10px; opacity: 0.7;">{{localize 'CLUEBOOK.Time.Days'}}</label>
              <input type="number" name="duration_days" value="{{duration.days}}" min="0" class="cluebook-input" style="width: 100%; text-align: center;">
            </div>
            <div style="flex: 1;">
              <label style="font-size: 10px; opacity: 0.7;">{{localize 'CLUEBOOK.Time.Hours'}}</label>
              <input type="number" name="duration_hours" value="{{duration.hours}}" min="0" class="cluebook-input" style="width: 100%; text-align: center;">
            </div>
            <div style="flex: 1;">
              <label style="font-size: 10px; opacity: 0.7;">{{localize 'CLUEBOOK.Time.Minutes'}}</label>
              <input type="number" name="duration_minutes" value="{{duration.minutes}}" min="0" class="cluebook-input" style="width: 100%; text-align: center;">
            </div>
          </div>
        </div>
      </fieldset>
    {{else}}
      <div class="form-group" style="display: flex; flex-direction: column;">
        <input type="text" name="time" value="{{entry.time}}" class="cluebook-input cb-input-lg" placeholder="🕑 {{localize 'CLUEBOOK.Time.TimeDate'}}">
      </div>
    {{/if}}
  {{/if}}

  {{#if (eq sourceTab "gallery")}}
    <div class="form-group">
      <input type="text" name="name" value="{{entry.name}}" class="cluebook-input cb-input-lg" placeholder="📸 {{localize 'CLUEBOOK.Gallery.TitlePlaceholder'}}">
    </div>

    <!-- Style Selector: Polaroid vs Frameless -->
    <div class="form-group" style="display: flex; gap: 8px; align-items: center;">
      <label style="font-size: 12px; font-weight: bold; color: rgba(255,255,255,0.7); margin-left: 2px;">{{localize 'CLUEBOOK.Gallery.Style'}}:</label>
      <div class="cb-segmented-control" style="flex: 1;">
        <label>
          <input type="radio" name="frameStyle" value="polaroid" {{#if (or (eq entry.frameStyle "polaroid") (not entry.frameStyle))}}checked{{/if}}>
          <span><i class="fas fa-camera-retro"></i> {{localize 'CLUEBOOK.Gallery.StylePolaroid'}}</span>
        </label>
        <label>
          <input type="radio" name="frameStyle" value="frameless" {{#if (eq entry.frameStyle "frameless")}}checked{{/if}}>
          <span><i class="fas fa-map"></i> {{localize 'CLUEBOOK.Gallery.StyleFrameless'}}</span>
        </label>
      </div>
    </div>

    <!-- Crop / Fit Mode Selector -->
    <div class="form-group" style="display: flex; gap: 8px; align-items: center;">
      <div style="flex: 1;">
        <label style="font-size: 11px; opacity: 0.7; margin-bottom: 2px; display: block;">{{localize 'CLUEBOOK.Gallery.FitMode'}}:</label>
        <select name="cropMode" class="cluebook-input" style="width: 100%;">
          <option value="contain" {{#if (or (eq entry.cropMode "contain") (not entry.cropMode))}}selected{{/if}}>🖼️ {{localize 'CLUEBOOK.Gallery.FitContain'}}</option>
          <option value="cover" {{#if (eq entry.cropMode "cover")}}selected{{/if}}>📐 {{localize 'CLUEBOOK.Gallery.FitCover'}}</option>
        </select>
      </div>
      <div style="flex: 1;">
        <label style="font-size: 11px; opacity: 0.7; margin-bottom: 2px; display: block;">{{localize 'CLUEBOOK.Gallery.FocalPoint'}}:</label>
        <select name="cropPosition" class="cluebook-input" style="width: 100%;">
          <option value="center" {{#if (or (eq entry.cropPosition "center") (not entry.cropPosition))}}selected{{/if}}>🎯 {{localize 'CLUEBOOK.Gallery.PosCenter'}}</option>
          <option value="top" {{#if (eq entry.cropPosition "top")}}selected{{/if}}>⬆️ {{localize 'CLUEBOOK.Gallery.PosTop'}}</option>
          <option value="bottom" {{#if (eq entry.cropPosition "bottom")}}selected{{/if}}>⬇️ {{localize 'CLUEBOOK.Gallery.PosBottom'}}</option>
        </select>
      </div>
    </div>

    <!-- Image Attachment Field -->
    <div class="form-group cb-image-group" style="background: rgba(0,0,0,0.15); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 8px; display: flex; flex-direction: column; gap: 8px;">
      <div style="display: flex; gap: 6px; align-items: center;">
        <i class="fas fa-image" style="color: rgba(255,255,255,0.6); margin-left: 2px;"></i>
        <input type="text" name="img" value="{{entry.img}}" class="cluebook-input" placeholder="{{localize 'CLUEBOOK.Gallery.ImagePlaceholder'}}" style="flex: 1;">
        <button type="button" class="btn-file-picker cluebook-btn" data-target="img" title="{{localize 'CLUEBOOK.Gallery.ChooseFile'}}" style="padding: 4px 10px; cursor: pointer; background: rgba(123, 97, 255, 0.3); border: 1px solid var(--cb-accent); color: white; border-radius: 4px;">
          <i class="fas fa-folder-open"></i>
        </button>
        <button type="button" class="btn-remove-image cluebook-btn" title="{{localize 'CLUEBOOK.Gallery.RemoveImage'}}" style="padding: 4px 10px; cursor: pointer; background: rgba(255, 82, 82, 0.2); border: 1px solid #ff5252; color: #ff5252; border-radius: 4px;">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <!-- Image Preview Container -->
      <div class="cb-img-preview-container" style="display: {{#if entry.img}}flex{{else}}none{{/if}}; justify-content: center; align-items: center; max-height: 160px; overflow: hidden; border-radius: 4px; background: rgba(0,0,0,0.3); position: relative;">
        <img class="cb-img-preview" src="{{entry.img}}" style="max-height: 160px; max-width: 100%; object-fit: contain; border-radius: 4px;">
      </div>

      <div style="display: flex; gap: 8px; align-items: center;">
        <input type="text" name="caption" value="{{entry.caption}}" class="cluebook-input" placeholder="✍️ {{localize 'CLUEBOOK.Gallery.CaptionPlaceholder'}}" style="flex: 1;">
      </div>
    </div>
  {{/if}}

  {{#if (eq sourceTab "labels")}}
    <div class="form-group">
      <label style="font-size: 11px; opacity: 0.7; margin-bottom: 3px; display: block;">{{localize 'CLUEBOOK.Label.TextLabel'}}:</label>
      <input type="text" name="name" value="{{entry.name}}" class="cluebook-input cb-input-lg" placeholder="🏷️ {{localize 'CLUEBOOK.Label.TextPlaceholder'}}" autofocus>
    </div>

    <!-- Colors Row: Text Color & Background Color -->
    <div style="display: flex; gap: 10px;">
      <!-- Text Color -->
      <div class="form-group" style="flex: 1; background: rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 8px 10px;">
        <label style="font-size: 11px; opacity: 0.8; margin-bottom: 6px; display: block;">
          <i class="fas fa-font"></i> {{localize 'CLUEBOOK.Label.TextColor'}}:
        </label>
        <div style="display: flex; align-items: center; gap: 8px;">
          <input type="color" name="textColor" class="cb-label-color-input" value="{{#if entry.textColor}}{{entry.textColor}}{{else}}#ffffff{{/if}}" style="width: 44px; height: 32px; border: 1px solid rgba(255,255,255,0.2); border-radius: 4px; cursor: pointer; padding: 0; background: transparent;">
          <input type="text" value="{{#if entry.textColor}}{{entry.textColor}}{{else}}#ffffff{{/if}}" style="flex: 1; font-family: monospace; font-size: 12px;" class="cluebook-input" oninput="this.previousElementSibling.value = this.value" onchange="this.previousElementSibling.value = this.value">
        </div>
      </div>

      <!-- Background Color (Auto-hidden if Transparent) -->
      <div class="form-group cb-label-bg-group" style="flex: 1; background: rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 8px 10px; {{#if (eq entry.bgStyle "transparent")}}display: none;{{/if}}">
        <label style="font-size: 11px; opacity: 0.8; margin-bottom: 6px; display: block;">
          <i class="fas fa-fill-drip"></i> {{localize 'CLUEBOOK.Label.BgColor'}}:
        </label>
        <div style="display: flex; align-items: center; gap: 8px;">
          <input type="color" name="customColorHex" class="cb-label-bg-input" value="{{#if entry.color}}{{entry.color}}{{else}}#ffffff{{/if}}" style="width: 44px; height: 32px; border: 1px solid rgba(255,255,255,0.2); border-radius: 4px; cursor: pointer; padding: 0; background: transparent;">
          <input type="text" value="{{#if entry.color}}{{entry.color}}{{else}}#ffffff{{/if}}" style="flex: 1; font-family: monospace; font-size: 12px;" class="cluebook-input" oninput="this.previousElementSibling.value = this.value" onchange="this.previousElementSibling.value = this.value">
        </div>
      </div>
    </div>

    <!-- Typography & Background Style -->
    <div style="display: flex; gap: 8px;">
      <!-- Font Family -->
      <div class="form-group" style="flex: 2;">
        <label style="font-size: 11px; opacity: 0.7; margin-bottom: 2px; display: block;">{{localize 'CLUEBOOK.Label.FontFamily'}}:</label>
        <select name="fontFamily" class="cluebook-input" style="width: 100%;">
          <option value="caveat" {{#if (or (eq entry.fontFamily "caveat") (not entry.fontFamily))}}selected{{/if}}>✍️ {{localize 'CLUEBOOK.Label.FontCaveat'}}</option>
          <option value="inter" {{#if (eq entry.fontFamily "inter")}}selected{{/if}}>🔤 {{localize 'CLUEBOOK.Label.FontInter'}}</option>
          <option value="courier" {{#if (eq entry.fontFamily "courier")}}selected{{/if}}>⌨️ {{localize 'CLUEBOOK.Label.FontCourier'}}</option>
          <option value="cinzel" {{#if (eq entry.fontFamily "cinzel")}}selected{{/if}}>🏛️ {{localize 'CLUEBOOK.Label.FontCinzel'}}</option>
        </select>
      </div>

      <!-- Font Size (Numeric in px) -->
      <div class="form-group" style="flex: 1;">
        <label style="font-size: 11px; opacity: 0.7; margin-bottom: 2px; display: block;">{{localize 'CLUEBOOK.Label.FontSize'}} (px):</label>
        <input type="number" name="fontSize" class="cluebook-input" min="12" max="150" step="1" value="{{#if entry.fontSize}}{{entry.fontSize}}{{else}}28{{/if}}" style="width: 100%; text-align: center;">
      </div>

      <!-- Background Style -->
      <div class="form-group" style="flex: 2;">
        <label style="font-size: 11px; opacity: 0.7; margin-bottom: 2px; display: block;">{{localize 'CLUEBOOK.Label.BgStyle'}}:</label>
        <select name="bgStyle" class="cluebook-input" style="width: 100%;">
          <option value="glass" {{#if (or (eq entry.bgStyle "glass") (not entry.bgStyle))}}selected{{/if}}>✨ {{localize 'CLUEBOOK.Label.BgGlass'}}</option>
          <option value="solid" {{#if (eq entry.bgStyle "solid")}}selected{{/if}}>🎨 {{localize 'CLUEBOOK.Label.BgSolid'}}</option>
          <option value="transparent" {{#if (eq entry.bgStyle "transparent")}}selected{{/if}}>🚫 {{localize 'CLUEBOOK.Label.BgTransparent'}}</option>
        </select>
      </div>
    </div>
  {{/if}}

  {{#if (eq sourceTab "pins")}}
    <div class="form-group">
      <label style="font-size: 11px; opacity: 0.7; margin-bottom: 3px; display: block;">{{localize 'CLUEBOOK.Pin.TitleLabel'}}:</label>
      <input type="text" name="name" value="{{entry.name}}" class="cluebook-input cb-input-lg" placeholder="📍 {{localize 'CLUEBOOK.Pin.TitlePlaceholder'}}" autofocus>
    </div>

    <!-- Color & Background Style Row -->
    <div style="display: flex; gap: 10px;">
      <!-- Pin Color -->
      <div class="form-group" style="flex: 1; background: rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 8px 10px;">
        <label style="font-size: 11px; opacity: 0.8; margin-bottom: 6px; display: block;">
          <i class="fas fa-palette"></i> {{localize 'CLUEBOOK.Pin.Color'}}:
        </label>
        <div style="display: flex; align-items: center; gap: 8px;">
          <input type="color" name="customColorHex" class="cb-pin-color-input" value="{{#if entry.color}}{{entry.color}}{{else}}#ff5252{{/if}}" style="width: 44px; height: 38px; border: 1px solid rgba(255,255,255,0.2); border-radius: 4px; cursor: pointer; padding: 0; background: transparent;">
          <input type="text" value="{{#if entry.color}}{{entry.color}}{{else}}#ff5252{{/if}}" style="flex: 1; height: 38px; font-family: monospace; font-size: 13px;" class="cluebook-input" oninput="this.previousElementSibling.value = this.value" onchange="this.previousElementSibling.value = this.value">
        </div>
      </div>

      <!-- Background Style -->
      <div class="form-group" style="flex: 1; background: rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 8px 10px;">
        <label style="font-size: 11px; opacity: 0.8; margin-bottom: 6px; display: block;">
          <i class="fas fa-layer-group"></i> {{localize 'CLUEBOOK.Pin.BgStyle'}}:
        </label>
        <select name="bgStyle" class="cluebook-input" style="width: 100%; height: 38px; padding: 4px 10px; font-size: 13px; line-height: 28px; box-sizing: border-box;">
          <option value="transparent" {{#if (or (eq entry.bgStyle "transparent") (not entry.bgStyle))}}selected{{/if}}>🚫 {{localize 'CLUEBOOK.Pin.BgNone'}}</option>
          <option value="dark-glass" {{#if (eq entry.bgStyle "dark-glass")}}selected{{/if}}>🌙 {{localize 'CLUEBOOK.Pin.BgDarkGlass'}}</option>
          <option value="light-glass" {{#if (eq entry.bgStyle "light-glass")}}selected{{/if}}>☀️ {{localize 'CLUEBOOK.Pin.BgLightGlass'}}</option>
        </select>
      </div>
    </div>

    <!-- Pin Icon Picker -->
    <div class="form-group" style="background: rgba(0,0,0,0.18); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 8px 10px;">
      <label style="font-size: 11px; opacity: 0.8; margin-bottom: 8px; display: block;">{{localize 'CLUEBOOK.Pin.ChooseIcon'}}:</label>
      <div class="cb-icon-picker-grid" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <label class="cb-icon-option {{#if (or (eq entry.icon "fa-thumbtack") (not entry.icon))}}active{{/if}}" title="📌"><input type="radio" name="icon" value="fa-thumbtack" style="display: none;" {{#if (or (eq entry.icon "fa-thumbtack") (not entry.icon))}}checked{{/if}}><span><i class="fas fa-thumbtack"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-map-pin")}}active{{/if}}" title="📍"><input type="radio" name="icon" value="fa-map-pin" style="display: none;" {{#if (eq entry.icon "fa-map-pin")}}checked{{/if}}><span><i class="fas fa-map-pin"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-map-marker-alt")}}active{{/if}}" title="🗺️"><input type="radio" name="icon" value="fa-map-marker-alt" style="display: none;" {{#if (eq entry.icon "fa-map-marker-alt")}}checked{{/if}}><span><i class="fas fa-map-marker-alt"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-skull")}}active{{/if}}" title="💀"><input type="radio" name="icon" value="fa-skull" style="display: none;" {{#if (eq entry.icon "fa-skull")}}checked{{/if}}><span><i class="fas fa-skull"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-question")}}active{{/if}}" title="❓"><input type="radio" name="icon" value="fa-question" style="display: none;" {{#if (eq entry.icon "fa-question")}}checked{{/if}}><span><i class="fas fa-question"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-star")}}active{{/if}}" title="⭐"><input type="radio" name="icon" value="fa-star" style="display: none;" {{#if (eq entry.icon "fa-star")}}checked{{/if}}><span><i class="fas fa-star"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-crosshairs")}}active{{/if}}" title="🎯"><input type="radio" name="icon" value="fa-crosshairs" style="display: none;" {{#if (eq entry.icon "fa-crosshairs")}}checked{{/if}}><span><i class="fas fa-crosshairs"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-fire")}}active{{/if}}" title="🔥"><input type="radio" name="icon" value="fa-fire" style="display: none;" {{#if (eq entry.icon "fa-fire")}}checked{{/if}}><span><i class="fas fa-fire"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-eye")}}active{{/if}}" title="👁️"><input type="radio" name="icon" value="fa-eye" style="display: none;" {{#if (eq entry.icon "fa-eye")}}checked{{/if}}><span><i class="fas fa-eye"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-exclamation")}}active{{/if}}" title="❗"><input type="radio" name="icon" value="fa-exclamation" style="display: none;" {{#if (eq entry.icon "fa-exclamation")}}checked{{/if}}><span><i class="fas fa-exclamation"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-heart")}}active{{/if}}" title="❤️"><input type="radio" name="icon" value="fa-heart" style="display: none;" {{#if (eq entry.icon "fa-heart")}}checked{{/if}}><span><i class="fas fa-heart"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-shield-alt")}}active{{/if}}" title="🛡️"><input type="radio" name="icon" value="fa-shield-alt" style="display: none;" {{#if (eq entry.icon "fa-shield-alt")}}checked{{/if}}><span><i class="fas fa-shield-alt"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-gem")}}active{{/if}}" title="💎"><input type="radio" name="icon" value="fa-gem" style="display: none;" {{#if (eq entry.icon "fa-gem")}}checked{{/if}}><span><i class="fas fa-gem"></i></span></label>
        <label class="cb-icon-option {{#if (eq entry.icon "fa-key")}}active{{/if}}" title="🔑"><input type="radio" name="icon" value="fa-key" style="display: none;" {{#if (eq entry.icon "fa-key")}}checked{{/if}}><span><i class="fas fa-key"></i></span></label>
      </div>
    </div>

    <!-- Pin Note / Popover Description -->
    <div class="form-group">
      <label style="font-size: 11px; opacity: 0.7; margin-bottom: 3px; display: block;">{{localize 'CLUEBOOK.Pin.NoteLabel'}} (@UUID / {{localize 'CLUEBOOK.Pin.MentionSupport'}}):</label>
      <textarea name="note" class="cluebook-input" rows="4" placeholder="{{localize 'CLUEBOOK.Pin.NotePlaceholder'}}">{{entry.note}}</textarea>
    </div>
  {{/if}}

  <!-- Dedicated Drop Zone for Scene/Actor -->
  {{#if isGM}}
  {{#if (or (eq sourceTab "npc") (or (eq sourceTab "locations") (eq sourceTab "notes")))}}
  <div class="cb-entity-dropzone" style="border: 2px dashed rgba(255,255,255,0.2); border-radius: 6px; padding: 10px; text-align: center; color: rgba(255,255,255,0.5); transition: all 0.2s;">
    {{#if (and (eq sourceTab "npc") entry.actorUuid)}}
      <div class="cb-badge cb-badge-actor" data-action="remove-link" data-type="actorUuid" title="{{localize 'CLUEBOOK.Entry.RemoveActor'}}" style="display: inline-flex;">
        <i class="fas fa-user-ninja"></i> {{#if actorName}}{{actorName}}{{else}}{{localize 'CLUEBOOK.Entry.Actor'}}{{/if}} <i class="fas fa-times"></i>
      </div>
    {{else if (and (or (eq sourceTab "locations") (eq sourceTab "notes")) entry.sceneUuid)}}
      <div class="cb-badge cb-badge-scene" data-action="remove-link" data-type="sceneUuid" title="{{localize 'CLUEBOOK.Entry.RemoveScene'}}" style="display: inline-flex;">
        <i class="fas fa-map"></i> {{#if sceneName}}{{sceneName}}{{else}}{{localize 'CLUEBOOK.Entry.Scene'}}{{/if}} <i class="fas fa-times"></i>
      </div>
    {{/if}}
    
    <span class="cb-drop-placeholder" style="{{#if (or (and (eq sourceTab "npc") entry.actorUuid) (and (or (eq sourceTab "locations") (eq sourceTab "notes")) entry.sceneUuid))}}display: none;{{/if}}">
      <i class="fas fa-link"></i> {{#if (eq sourceTab "npc")}}{{localize 'CLUEBOOK.Entry.DropActor'}}{{else}}{{localize 'CLUEBOOK.Entry.DropScene'}}{{/if}}
    </span>
  </div>
  {{/if}}
  {{/if}}

  <!-- Tabs for Text -->
  {{#unless (or (eq sourceTab "gallery") (eq sourceTab "labels") (eq sourceTab "pins"))}}
  <div class="cb-tabs-container">
    <div class="cb-tab-headers">
      <div class="cb-tab-header active" data-tab="public-notes"><i class="fas fa-align-left"></i> {{localize 'CLUEBOOK.Entry.Description'}}</div>
      {{#if isGM}}
      <div class="cb-tab-header" data-tab="gm-notes"><i class="fas fa-user-secret"></i> {{localize 'CLUEBOOK.Entry.GMNotes'}}</div>
      {{/if}}
    </div>
    
    <div class="cb-tab-content active" data-tab="public-notes">
      {{#if (eq sourceTab "notes")}}
        <textarea name="text" class="cluebook-input" rows="8" placeholder="{{localize 'CLUEBOOK.Entry.NotePlaceholder'}}">{{entry.text}}</textarea>
      {{else if (eq sourceTab "npc")}}
        <textarea name="note" class="cluebook-input" rows="8" placeholder="{{localize 'CLUEBOOK.Entry.NPCPH'}}">{{entry.note}}</textarea>
      {{else if (eq sourceTab "locations")}}
        <textarea name="note" class="cluebook-input" rows="8" placeholder="{{localize 'CLUEBOOK.Entry.LocationPH'}}">{{entry.note}}</textarea>
      {{else if (eq sourceTab "quests")}}
        <textarea name="text" class="cluebook-input" rows="8" placeholder="{{localize 'CLUEBOOK.Entry.QuestPH'}}">{{entry.text}}</textarea>
      {{else if (eq sourceTab "timeline")}}
        <textarea name="event" class="cluebook-input" rows="8" placeholder="{{localize 'CLUEBOOK.Entry.TimelinePH'}}">{{entry.event}}</textarea>
      {{else if (eq sourceTab "pins")}}
        <textarea name="note" class="cluebook-input" rows="8" placeholder="{{localize 'CLUEBOOK.Pin.NotePlaceholder'}}">{{entry.note}}</textarea>
      {{/if}}
    </div>
    
    {{#if isGM}}
    <div class="cb-tab-content" data-tab="gm-notes">
      <textarea name="gmNotes" class="cluebook-input gm-notes-input" rows="8" placeholder="{{localize 'CLUEBOOK.Entry.GMNotesPH'}}">{{entry.gmNotes}}</textarea>
    </div>
    {{/if}}
  </div>
  {{/unless}}
  {{/unless}}

  <!-- Tags Input Row -->
  {{#if (and showTags (ne sourceTab "labels") (ne sourceTab "pins"))}}
  <div class="form-group cb-tags-input-group" style="position: relative;">
    <div style="display: flex; gap: 8px; align-items: center;">
      <i class="fas fa-tags" style="color: rgba(255,255,255,0.4); margin-left: 5px;"></i>
      <div class="cb-tags-wrapper" style="flex: 1; display: flex; flex-wrap: wrap; gap: 5px; align-items: center; background: rgba(0,0,0,0.1); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 4px; min-height: 32px;">
        {{#each entry.resolvedTags}}
          <span class="cb-tag {{#if this.isSecret}}cb-tag-secret{{/if}}" data-tag-id="{{this.id}}" style="background: {{this.color}};">
            {{this.name}}
            <i class="fas fa-times cb-tag-remove"></i>
          </span>
        {{/each}}
        <input type="text" class="cb-tag-input" placeholder="{{localize 'CLUEBOOK.Tags.InputPlaceholder'}}" style="border: none; background: transparent; color: #fff; outline: none; flex: 1; min-width: 100px;">
      </div>
    </div>
    <!-- Autocomplete Dropdown -->
    <div class="cb-tags-autocomplete" style="display: none; position: absolute; bottom: 100%; left: 30px; right: 0; background: #1a1a24; border: 1px solid rgba(123, 97, 255, 0.5); border-radius: 4px; max-height: 150px; overflow-y: auto; z-index: 10; margin-bottom: 5px;">
      <!-- populated dynamically -->
    </div>
    <!-- Hidden input to store actual tags array for form submission -->
    <input type="hidden" name="tags" value="">
  </div>
  {{else}}
    <input type="hidden" name="tags" value="">
  {{/if}}

  <div style="margin-top: 5px; display: flex; gap: 10px; justify-content: center;">
    <button type="button" data-action="saveDialog" class="cluebook-btn" style="flex: 1; padding: 8px; font-size: 14px; font-weight: bold; background: rgba(255,255,255,0.1); border: 1px solid var(--cb-accent); color: #fff; border-radius: 4px; cursor: pointer;">
      <i class="fas fa-save"></i> {{localize 'CLUEBOOK.Entry.Save'}}
    </button>
    <button type="button" data-action="saveDialog" data-close="true" class="cluebook-btn" style="flex: 1; padding: 8px; font-size: 14px; font-weight: bold; background: var(--cb-accent); color: #fff; border: none; border-radius: 4px; cursor: pointer;">
      <i class="fas fa-check"></i> {{localize 'CLUEBOOK.Entry.SaveAndClose'}}
    </button>
  </div>
</div>
