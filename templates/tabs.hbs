<nav class="tabs" data-group="primary">
  {{#each tabs}}
    <a class="item {{#if (eq ../activeTab this.id)}}active{{/if}}" data-tab="{{this.id}}" title="{{this.label}}">
      <i class="{{this.icon}}"></i>
    </a>
  {{/each}}
  <div class="mode-toggle">
    <a class="item {{#if (eq activeTab 'workspaces')}}active{{/if}}" data-tab="workspaces" title="{{localize 'CLUEBOOK.Settings.ManageBoards'}}">
      <i class="fas fa-layer-group"></i>
    </a>
    {{#if showTags}}
    <a class="item" data-action="manageTags" title="{{localize 'CLUEBOOK.Tags.Manage'}}">
      <i class="fas fa-tags"></i>
    </a>
    {{/if}}
    <a class="item {{#if (eq activeTab 'settings')}}active{{/if}}" data-tab="settings" title="{{localize 'CLUEBOOK.Settings.Title'}}">
      <i class="fas fa-cog"></i>
    </a>
  </div>
</nav>
